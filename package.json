{
  "name": "onecocreation",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 117",
    "edge >= 117",
    "firefox >= 121",
    "safari >= 17.5"
  ],
  "scripts": {
    "predev": "node scripts/setup.mjs && node scripts/reset-registry.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "reset:registry": "node scripts/reset-registry.mjs",
    "sync:briefs": "node scripts/sync-briefs.mjs",
    "check:leaks": "node scripts/check-no-leaked-assets.mjs",
    "check:usability": "node scripts/check-usability.mjs",
    "studio:bench": "node scripts/studio-bench.mjs",
    "studio:bench:fresh": "node scripts/studio-bench.mjs --fresh",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@onecocreation/operator-auth": "file:packages/operator-auth",
    "@onecocreation/page-store": "file:packages/page-store",
    "@frens-earth/arcade-ui": "https://github.com/PacsArcade/arcade-ui/releases/download/arcade-ui-v0.5.0/frens-earth-arcade-ui-0.5.0.tgz",
    "@frens-earth/plugin-rails": "https://github.com/PacsArcade/puck-studio/releases/download/plugin-rails-v0.4.0/frens-earth-plugin-rails-0.4.0.tgz",
    "@frens-earth/presence": "https://github.com/PacsArcade/puck-studio/releases/download/presence-v0.2.0/frens-earth-presence-0.2.0.tgz",
    "@frens-earth/puck-changelog": "https://github.com/PacsArcade/puck-studio/releases/download/puck-changelog-v0.2.0/frens-earth-puck-changelog-0.2.0.tgz",
    "@frens-earth/puck-config": "https://github.com/PacsArcade/puck-studio/releases/download/puck-config-v0.14.0/frens-earth-puck-config-0.14.0.tgz",
    "@frens-earth/variant-engine": "https://github.com/PacsArcade/puck-studio/releases/download/variant-engine-v0.4.0/frens-earth-variant-engine-0.4.0.tgz",
    "@puckeditor/core": "^0.23.0",
    "@types/nodemailer": "^8.0.1",
    "@vercel/blob": "^2.5.0",
    "heic2any": "^0.0.4",
    "next": "16.3.5",
    "nodemailer": "^9.1.1",
    "nostr-tools": "^2.23.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^6.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.26",
    "next": {
      "sharp": "0.35.4"
    },
    "@puckeditor/core": {
      "@tiptap/core": "3.30.5",
      "@tiptap/extension-blockquote": "3.30.5",
      "@tiptap/extension-bold": "3.30.5",
      "@tiptap/extension-bubble-menu": "3.30.5",
      "@tiptap/extension-code": "3.30.5",
      "@tiptap/extension-code-block": "3.30.5",
      "@tiptap/extension-document": "3.30.5",
      "@tiptap/extension-floating-menu": "3.30.5",
      "@tiptap/extension-hard-break": "3.30.5",
      "@tiptap/extension-heading": "3.30.5",
      "@tiptap/extension-horizontal-rule": "3.30.5",
      "@tiptap/extension-italic": "3.30.5",
      "@tiptap/extension-link": "3.30.5",
      "@tiptap/extension-list": "3.30.5",
      "@tiptap/extension-paragraph": "3.30.5",
      "@tiptap/extension-strike": "3.30.5",
      "@tiptap/extension-text": "3.30.5",
      "@tiptap/extension-text-align": "3.30.5",
      "@tiptap/extension-underline": "3.30.5",
      "@tiptap/html": "3.30.5",
      "@tiptap/react": "3.30.5"
    }
  },
  "description": "One Cocreation — Love's site, cloned from the frens.earth store framework."
}
