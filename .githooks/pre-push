#!/usr/bin/env bash
# pre-push — law guard (plan-of-action §10 row 0.6). The gate re-run here IS the truth: there is no GATES-GREEN stamp to forge.
# Law: gate-script (a push to a protected branch happens only on a green gate, run now, on exactly the commit being pushed).
# Refuses: a red gate · a dirty tree (the gate would test files that are not in the push) · a pushed sha that is not HEAD · a deleted protected branch.
set -uo pipefail
top="$(git rev-parse --show-toplevel)"
conf="${top}/.githooks/law.conf"
[ -f "${conf}" ] || { echo "✗ law-guard: ${conf} missing — refusing (fail-closed)"; exit 1; }
# shellcheck disable=SC1090
. "${conf}"
zero="0000000000000000000000000000000000000000"
need=0
while read -r _lref lsha rref _rsha; do
  name="${rref#refs/heads/}"
  for p in ${PROTECTED:-}; do
    if [ "${name}" = "${p}" ]; then
      [ "${lsha}" = "${zero}" ] && { echo "✗ never-delete law: this push deletes ${p} — refused"; exit 1; }
      [ "${lsha}" = "$(git rev-parse HEAD)" ] || { echo "✗ gate-script law: the push to ${p} is ${lsha:0:9}, the checkout is $(git rev-parse --short HEAD) — the gate can only vouch for the checked-out commit"; exit 1; }
      need=1
    fi
  done
done
[ $need -eq 1 ] || exit 0
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "✗ gate-script law: the tree has uncommitted changes — the gate would test files that are not in this push"; exit 1; }
[ -n "${GATE:-}" ] || { echo "✗ law-guard: no GATE in law.conf — refusing (fail-closed)"; exit 1; }
cmd="${GATE//\{top\}/${top}}"
echo "law-guard: protected push → running the gate: ${cmd}"
# the gate's own output reaches the terminal whole — never through grep (gate-script law)
${cmd} </dev/null
rc=$?
[ $rc -eq 0 ] && { echo "law-guard: gate green → push allowed"; exit 0; }
echo "✗ gate-script law: gate exit ${rc} — push refused"; exit 1
