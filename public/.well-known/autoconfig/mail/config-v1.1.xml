<?xml version="1.0" encoding="UTF-8"?>
<!-- Thunderbird/K-9 mail autoconfig for onecocreation.com (0018.06.01 a₿).
     Served from the site at /.well-known/autoconfig/mail/config-v1.1.xml —
     one of the standard locations Thunderbird probes when an address's
     domain is onecocreation.com. Mailboxes live on the ZAP Hosting Plesk
     deck (mail.onecocreation.com); Plesk's own autodiscover is also enabled
     panel-side and answers once DNS carries autoconfig/autodiscover hosts. -->
<clientConfig version="1.1">
  <emailProvider id="onecocreation.com">
    <domain>onecocreation.com</domain>
    <displayName>One Cocreation Mail</displayName>
    <displayShortName>OneCocreation</displayShortName>
    <incomingServer type="imap">
      <hostname>mail.onecocreation.com</hostname>
      <port>993</port>
      <socketType>SSL</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>
    <incomingServer type="imap">
      <hostname>mail.onecocreation.com</hostname>
      <port>143</port>
      <socketType>STARTTLS</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>
    <outgoingServer type="smtp">
      <hostname>mail.onecocreation.com</hostname>
      <port>465</port>
      <socketType>SSL</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </outgoingServer>
    <outgoingServer type="smtp">
      <hostname>mail.onecocreation.com</hostname>
      <port>587</port>
      <socketType>STARTTLS</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </outgoingServer>
  </emailProvider>
  <webMail>
    <loginPage url="https://webmail.onecocreation.com/" />
  </webMail>
</clientConfig>
