# ── Space configuration ──────────────────────────────────────────────
# One deployment = one space. Fork this repo, change these two values,
# and you have a registration site for your own Spaces-protocol space.

# The space this site registers names under (tag = name@<space>)
NEXT_PUBLIC_SPACE_NAME=onecocreation

# The domain this site is served from. NIP-05 identities are
# name@<this domain>, so it MUST be the domain that serves
# /.well-known/nostr.json (i.e. this app's production domain).
NEXT_PUBLIC_NIP05_DOMAIN=onecocreation.com

# ── Storage (production only) ────────────────────────────────────────
# Vercel Blob store token — local dev uses a JSON file instead and
# works with no configuration at all.
#   npx vercel blob create-store my-registry --access public --yes
BLOB_READ_WRITE_TOKEN=

# ── Fren sessions ────────────────────────────────────────────────────
# HMAC secret for the pa-fren login/session cookie. REQUIRED in production:
# without it, returning sign-in, tag release, and /admin all 500.
# Any long random string:  openssl rand -hex 32
SEAT_SECRET=

# ── Operator console (/a admin) ──────────────────────────────────────
# Comma-separated npubs allowed into the /a admin areas. Leave empty to
# disable them entirely.
#   OPERATOR_NPUBS=npub1abc...,npub1def...
OPERATOR_NPUBS=

# Comma-separated emails allowed in through their ordinary email sign-in —
# the email seat, an interim door while an operator's key is being worked
# out. Same access as an npub on OPERATOR_NPUBS. Leave empty to disable.
#   OPERATOR_EMAILS=love@example.com
OPERATOR_EMAILS=

# ── Spaces node (on-chain anchoring — optional) ──────────────────────
# This deployment's own `spaced` JSON-RPC endpoint. Leave unset and tags
# stay `queued` (still fully usable on nostr). `spaced` is localhost-only
# with no built-in auth, so a remote/serverless deploy must point this at an
# authenticating proxy and set a token. See docs/spaces-anchoring.md.
#   SPACES_NODE_URL=http://127.0.0.1:7225
SPACES_NODE_URL=
SPACES_NODE_TOKEN=

# ── SCAR merge queue (optional) ──────────────────────────────────────
# Fine-grained GitHub PAT so the /a/scar AUTHORIZE button can list PRs and
# execute sha-guarded merges. Generate at github.com → Settings → Developer
# settings → Fine-grained tokens: resource owner = your org, repository
# access = this repo only, permissions = Contents (read/write) +
# Pull requests (read/write). Without it, signed authorizations are still
# recorded — merges just happen on GitHub.
GITHUB_TOKEN=
# The repo the queue watches (owner/name). Defaults to PacsArcade/frens.earth.
GITHUB_REPO=

# ── MUD node (P.O.K.E. — optional) ───────────────────────────────────
# This deployment's own MUD node (knowledge-engine, admin API on :4001).
# Tickets work without it; the game surface stays dark until set.
# MUD_ADMIN_TOKEN is the node's X-POKE-Admin-Token. See docs/spaces-anchoring.md.
#   MUD_NODE_URL=http://127.0.0.1:4001
MUD_NODE_URL=
MUD_ADMIN_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────
# Force the Vercel Blob driver in local dev (needs BLOB_READ_WRITE_TOKEN too).
# On Vercel the blob driver turns on automatically; unset locally = file driver.
#   REGISTRY_DRIVER=blob
REGISTRY_DRIVER=

# Knowledge-engine node backing the profile's P.O.K.E. card (arcade stats).
# Optional — the card degrades gracefully when unset.
#   POKE_NODE_URL=https://node.example
#   NEXT_PUBLIC_POKE_NODE_URL=https://node.example
POKE_NODE_URL=
NEXT_PUBLIC_POKE_NODE_URL=

# ── The money rail — BTCPay (docs/btcpay-wiring.md is the runbook) ─────────
# NON-CUSTODIAL: points at the ARTIST'S OWN store on their BTCPay server.
# API key scope: cancreateinvoice + canviewinvoices ONLY, pinned to the store.
BTCPAY_URL=""              # e.g. https://btcpay.pacsarcade.org
BTCPAY_STORE_ID=""         # Store Settings → General
BTCPAY_API_KEY=""          # avatar → Manage Account → API Keys (shows once)
BTCPAY_WEBHOOK_SECRET=""   # Store → Webhooks — SEPARATE credential from the key

# ── The order vault — private KV (orders/PII never touch public storage) ───
# Vercel → Storage → Redis → Connect Project (prefix KV). Auto-injected:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Dev uses data/store-orders/ files.

# ── The studio's page store (@pacsarcade/page-store) ─────────────────
# The same KV above backs the visual editor's DRAFT/LIVE staging. Driver
# selection (default kv — today's behaviour, byte-identical):
#   kv         — Upstash REST via the KV_REST_API_* vars above
#   filesystem — JSON files, local dev with no KV can finally SAVE
#   git        — scoped design stub; selecting it throws (not implemented)
#PUCK_STORE_DRIVER=kv
# Filesystem driver's directory (default data/puck-store/ under the repo):
#PUCK_STORE_FS_DIR=
# Site namespace prepended to every puck key (write-under-namespace, read
# namespace-then-legacy so already-live pages keep resolving). Leave unset
# for today's bare keys; set it before two sites ever share one KV.
#PUCK_STORE_NAMESPACE=

# ── One Cocreation clone additions ───────────────────────────────────
# The admin wears Love's own site chrome rather than the arcade's LCARS
# bridge (captain's call ~0018.05.03). Paired with the de-housed
# src/components/console/site-chrome.tsx, which points at SiteHeader/
# SiteFooter instead of ArcadeHeader/EarthFooter.
NEXT_PUBLIC_CONSOLE_CHROME=site
NEXT_PUBLIC_NODE_NAME=ONECOCREATION

# The host named on booking confirmations and calendar files. Without it
# the .ics carries NO ORGANIZER rather than a fabricated address.
BOOKING_ORGANIZER_EMAIL=love@onecocreation.com

# ── The money rail — Love's OWN BTCPay store ─────────────────────────
# NON-CUSTODIAL for on-chain: BTCPay derives receiving addresses from
# Love's xpub, so sats land in Love's wallet and no host holds a key.
# ⚠ Lightning is the exception — channel funds live in whichever node
# BTCPay is pointed at. If that is the arcade's node, lightning is
# CUSTODIAL through the arcade; say so in the copy.
# ⚠ NOT YET SET — checkout and booking honestly refuse until they are.
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# ── The money rail — Square (docs/payments-square.md is the runbook) ───────
# CARD-FIAT ONLY: Square never accepts a sats amount, and this codebase
# never invents a sats↔fiat rate to bridge that gap — an item with no fiat
# price is honestly refused as "not purchasable by card," not converted.
# Unset = the card rail honestly stays dark and the site is byte-for-byte
# unchanged (no card option renders anywhere); BTCPay keeps being the
# default rail either way.
# ⚠ NOT YET SET — the card rail honestly refuses until these are.
SQUARE_ACCESS_TOKEN=""             # Developer Dashboard → your app → Credentials
SQUARE_LOCATION_ID=""              # Developer Dashboard → your app → Locations
SQUARE_ENVIRONMENT="sandbox"       # "sandbox" | "production" — default sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=""    # Developer Dashboard → Webhooks → Signature Key
# The webhook subscription URL EXACTLY as entered in the Square dashboard
# (https, no trailing slash mismatch) — Square's signature is computed over
# this URL + the raw body, and it isn't sent in any header, so the site
# needs its own copy to verify. Get this one character off and every
# webhook silently fails to verify.
SQUARE_WEBHOOK_URL=""              # e.g. https://yoursite.example/api/store/webhook/square

# ── Tenant namespacing (TASK-97, cut 0018.06.10 a₿) ────────────────────
# One env-driven tenant name behind every tenant-scoped KV key and HMAC
# label (brand palette, the media rail's saved GitHub token, the presence
# room). DEFAULT 'onecocreation' — under the default every key is
# byte-identical to the pre-namespacing literals, so existing data keeps
# resolving. Set it only when a second StudioPac tenant shares this
# infrastructure. (The puck page store has its own PUCK_STORE_NAMESPACE
# above — same idea, that package's own lever.)
#TENANT=onecocreation

# ── The studio copilot (Number One, /studio right-hand dock) ───────────
# TWO backends; the copilot is configured if EITHER is set, and OLLAMA_URL
# WINS when both are set (src/lib/copilot.ts: generatePage routes to the
# local agent first, so a local run stays sovereign — no Anthropic credits
# spent). The Anthropic key must be the full ~108-character sk-ant- key —
# the code refuses truncated pastes.
#ANTHROPIC_API_KEY=sk-ant-...
#   OLLAMA_URL=http://localhost:11434   (local dev) or a reachable VPS endpoint
#OLLAMA_URL=
#OLLAMA_MODEL=llama3.1

# ── Presence (studio multiplayer awareness) ────────────────────────────
# HMAC source for the presence room id + encryption key (NEVER handed to
# clients — /api/presence returns only the derived pair). Falls back to
# SEAT_SECRET. Rotating it rotates the room: the ex-operator eviction lever.
#PRESENCE_SECRET=
# Comma-separated nostr relay pool (default wss://relay.damus.io, wss://nos.lol).
#PRESENCE_RELAYS=wss://relay.damus.io,wss://nos.lol

# ── Outbound mail (SMTP) ───────────────────────────────────────────────
# nodemailer transport for booking/news mail. Credentials are PER PERSONA
# (mail.ts MailPersona): SMTP_USER_BOOKINGS/SMTP_PASS_BOOKINGS and
# SMTP_USER_NEWS/SMTP_PASS_NEWS (SMTP_<PERSONA>_PASS also reads); From
# defaults to the user, override with MAIL_FROM_<PERSONA>. Unset = mail
# honestly refuses; nothing fabricates a sender.
#SMTP_HOST=
#SMTP_PORT=465
#SMTP_USER_BOOKINGS=
#SMTP_PASS_BOOKINGS=
#SMTP_USER_NEWS=
#SMTP_PASS_NEWS=
#MAIL_FROM_BOOKINGS=
#MAIL_FROM_NEWS=
# Vault-backed hourly send cap (default 100).
#MAIL_HOURLY_CAP=100
# Bearer for Vercel cron hitting /api/mail/tick (the seat secret and an
# operator cookie also open it).
#CRON_SECRET=
# Where /api/contact delivers (default love@onecocreation.com) and where
# PWYC offer notifications go (same default).
#CONTACT_INBOX=
#OFFER_NOTIFY_EMAIL=

# ── Matrix bridge (rooms, the login door, ceremonies) ──────────────────
#MATRIX_HOMESERVER=https://matrix.onecocreation.com
# Bot token for room admin; MATRIX_OCC_ADMIN_TOKEN reads as its fallback.
#MATRIX_BOT_TOKEN=
#MATRIX_OCC_ADMIN_TOKEN=
# Signs the JWT the /api/matrix/login door hands to the homeserver.
#MATRIX_OCC_JWT_SECRET=

# ── Node links — bootstrap fallbacks (stored /a console config WINS) ───
# Chain-data node (default: the public mempool.space, honestly labeled).
#MEMPOOL_NODE_URL=
# Chat door (the one node link with a house default so a fresh fork's door
# still opens somewhere honest).
#CHAT_NODE_URL=

# ── Briefs sync (scripts/sync-briefs.mjs + nodeconfig) ─────────────────
#BRIEFS_REPO=PacsArcade/frens-briefs
#BRIEFS_BRANCH=main
#BRIEFS_TOKEN=
#SHARED_BRIEFS_REPO=PacsArcade/frens-briefs-public
#SHARED_BRIEFS_BRANCH=main

# ── Print/fulfilment (store admin) ─────────────────────────────────────
#PRINTFUL_API_KEY=
#FOURTHWALL_API_TOKEN=   (FOURTHWALL_API_KEY also reads)

# ── Artist roster bootstrap ────────────────────────────────────────────
# Comma-separated npubs; the operator-editable roster (GUI) wins, this env
# is the bootstrap fallback (docs/artist-registry.md).
#ARTIST_NPUBS=

# ── The media rail (studio image uploads → git) ────────────────────────
# Uploads commit to this repo and serve via raw.githubusercontent (public
# repo = unauthed raw URLs). Auth is the GITHUB_TOKEN above, or a token
# pasted into the studio (saved tenant-namespaced in KV).
#GITHUB_ASSETS_REPO=ONECocreation/onecocreation-assets
#GITHUB_ASSETS_BRANCH=main

# ── Order vault — alternate driver ─────────────────────────────────────
# node-redis client for the vault libs that prefer a socket over Upstash
# REST (booking-orders, entitlement, store). Either driver needs one of
# the two configured; unset everywhere = file-based dev fallbacks.
#REDIS_URL=

# ── Site URL, build stamp, and the studio bench ────────────────────────
# Absolute base for links in outbound mail (falls back to
# VERCEL_PROJECT_PRODUCTION_URL — Vercel-injected — then localhost).
#NEXT_PUBLIC_SITE_URL=https://onecocreation.com
# Build stamp shown in the merge queue — SET BY next.config.ts at build
# time; never hand-set it.
#NEXT_PUBLIC_BUILD_AT=
# The design bench: local-only (NODE_ENV != production) preview surfaces.
# STUDIO_BENCH=1 opens the gate; NEXT_PUBLIC_BENCH_CARTRIDGE=mono|blank
# dresses the bench in a sibling cartridge.
#STUDIO_BENCH=
#NEXT_PUBLIC_BENCH_CARTRIDGE=

# ── Platform-injected (Vercel sets these; documented, not configured) ──
# VERCEL=1                         — driver auto-selection reads it
# VERCEL_PROJECT_PRODUCTION_URL    — mail link fallback above
